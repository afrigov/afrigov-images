{
  "name": "afrigov-images",
  "version": "0.1.0",
  "description": "Make images light enough for African government websites. Resizes for each screen, converts to WebP, removes location data, checks the afrigov weight limits and prints the HTML.",
  "keywords": [
    "images",
    "webp",
    "responsive-images",
    "srcset",
    "compression",
    "performance",
    "government",
    "africa",
    "cli",
    "afrigov"
  ],
  "license": "MIT",
  "author": "Abimbola Omoyola",
  "homepage": "https://github.com/omoyolab/afrigov-images#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/omoyolab/afrigov-images.git"
  },
  "bugs": {
    "url": "https://github.com/omoyolab/afrigov-images/issues"
  },
  "type": "module",
  "bin": {
    "afrigov-images": "./dist/cli.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.30.2",
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "check": "pnpm lint && pnpm typecheck && pnpm format:check && pnpm build && pnpm test",
    "prepublishOnly": "pnpm check"
  },
  "dependencies": {
    "sharp": "^0.35.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.6.3",
    "eslint": "^10.11.0",
    "prettier": "^3.9.9",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.71.0",
    "vitest": "^5.0.2"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  }
}
